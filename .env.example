# Copy the private key from the Vapi dashboard. Never expose it in frontend code.
VAPI_API_KEY=replace-with-your-vapi-private-key

# This is your own webhook password; Vapi does not provide it.
# Generate a long random value and configure the same value in your webhook caller.
VAPI_SECRET=generate-your-own-long-random-webhook-secret

VAPI_BASE_URL=https://api.vapi.ai
